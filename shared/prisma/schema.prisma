generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String    @id @default(uuid())
  email                   String    @unique
  username                String    @unique
  password                String
  avatarUrl               String?
  twoFactorSecret         String?
  twoFactorSecretEnabled  Boolean   @default(false)
  createdAt               DateTime  @default(now())

  // Friendship
  sentRequests     Friendship[] @relation("sentRequests")
  receivedRequests Friendship[] @relation("receivedRequests")

  // Direct Chat
  sentMessages     DirectMessage[] @relation("sentMessages")
  receivedMessages DirectMessage[] @relation("receivedMessages")

  // Block User
  blockedUsers     BlockedFriendship[] @relation("blockedUsers")
  blockedBy        BlockedFriendship[] @relation("blockedBy")
}

enum FriendshipStatus {
  pending
  accepted
}

model Friendship {
  id        String            @id @default(uuid())
  userId    String
  friendId  String
  status    FriendshipStatus  @default(pending)   
  createdAt DateTime          @default(now())

  user      User @relation("sentRequests", fields: [userId], references: [id], onDelete: Cascade)
  friend    User @relation("receivedRequests", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId], name: "userId_friendId")
}

model DirectMessage {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  content    String
  messageType String   @default("text") // "text" | "game_invite"
  gameRoomId  String?  // Optional: UUID of gameroom 
  delivered  Boolean @default(false)
  createdAt  DateTime @default(now())

  sender     User     @relation("sentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User     @relation("receivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId, receiverId])
  @@index([receiverId, delivered])
}

model BlockedFriendship {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker   User     @relation("blockedUsers", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("blockedBy", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

model Match {
  id        String   @id @default(uuid())
  mode      String
  players   String[]
  ranking   String[]
  winnerId  String
  chatLog   Json     @default("[]")
  moveLog   Json     @default("[]")
  startedAt DateTime @default(now())
  endedAt   DateTime @default(now())
}

