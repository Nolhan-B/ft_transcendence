# ft_transcendence — environment variables
#
# Copy this file to `.env` (ignored by Git) and adjust the values:
#     cp .env.example .env
#
# REAL SECRETS (database password, connection URL, JWT key) do NOT belong here:
# they live in `secrets/` (Docker secrets), created by `make install` from `secrets.example/`.
# This file only holds the non-secret configuration read by the code.

# --- PostgreSQL database ------------------------------------------------------
# The password is read from /run/secrets/db_password (secrets/db_password.txt).
# DB_USER and DB_NAME also create the Postgres user/database on the FIRST start of the
# volume (changing them later requires `docker compose down -v`), and secrets/db_url.txt
# (used by `prisma db push`) must contain the same user and database name.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=transcendence_db
DB_USER=transcendence_user

# --- Public ports exposed on the host (Nginx gateway) --------------------------
# Change them if another program already uses 8080 or 8443 on your machine.
# If you change HTTPS_PORT, also update API_URL / WS_URL in the Tests section below.
HTTP_PORT=8080
HTTPS_PORT=8443

# --- Tests (.github/scripts, integration tests) -------------------------------
# URLs targeted by the test scripts. The HTTPS certificate is self-signed locally.
# NODE_TLS_REJECT_UNAUTHORIZED=0 disables certificate checks: for local tests only,
# never for the services themselves.
API_URL=https://localhost:8443/api
WS_URL=wss://localhost:8443/api/game/ws
NODE_TLS_REJECT_UNAUTHORIZED=0
